# FastAPI backend (backend/python)
# GENERATED from config/secrets.manifest.json - edit the manifest, then run
#   python scripts/secrets/gen_env_examples.py
# Names only. Secrets stay empty here and live in the central vault (docs/SECRETS_ARCHITECTURE.md).

# --- Secrets (server-only, from the vault) ---
# AI_API_KEY: [required in: staging, prod] - Groq or any OpenAI-compatible key
AI_API_KEY=
# AI_API_KEY2: - optional rate-limit spread
AI_API_KEY2=
# AI_API_KEY3: - optional rate-limit spread
AI_API_KEY3=
CLAUDE_API_KEY=
OPEN_AI_API_KEY=
OPENCODE_API_KEY=
# GIT_TOKEN_JAZPER: - GitHub token for gitops features; use a fine-grained, repo-scoped token
GIT_TOKEN_JAZPER=
TAVILY_API_KEY=
BRAVE_API_KEY=
EXA_AI_API_KEY=
GOOGLE_CUSTOM_SEARCH_API=
GOOGLE_CLIENT_SECRET=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
# WS_TOKEN: [required in: staging, prod] - protects /ws/rpc
WS_TOKEN=
# POSTGRES_PASSWORD: [required in: dev, staging, prod]
POSTGRES_PASSWORD=
# REDIS_PASSWORD: [required in: dev, staging, prod]
REDIS_PASSWORD=
# MINIO_ROOT_PASSWORD: [required in: staging, prod]
MINIO_ROOT_PASSWORD=

# --- Config (non-sensitive) ---
# ENV: - development | staging | production
ENV=development
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=qwen/qwen3.8-27b
LIGHT_MODEL=openai/gpt-oss-20b
GOOGLE_CSE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/google/oauth/callback
# LINKEDIN_CHROME_PROFILE_PATH: - local path, dev machine only
LINKEDIN_CHROME_PROFILE_PATH=
# RESUME_PATH: - local path, dev machine only
RESUME_PATH=
OFFICE_AUTH_REQUIRED=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=sirjazper
POSTGRES_DB=coos
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_BUCKET=sirjazper
MINIO_ROOT_USER=sirjazper
FASTAPI_PORT=8000
FRONTEND_URL=http://localhost:3001
