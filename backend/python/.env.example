ENV=development

# AI — Groq (free tier)
# Create a free key at https://console.groq.com/keys and paste it below (or add it later in the app: System -> Secrets / AI Providers).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
# optional second/third key to spread the free-tier rate limits
AI_API_KEY2=
AI_API_KEY3=
AI_MODEL=qwen/qwen3.8-27b
LIGHT_MODEL=openai/gpt-oss-20b
# other Groq chat models: openai/gpt-oss-120b (strongest), openai/gpt-oss-20b (fastest)

# PostgreSQL — credentials must match backend/infra/.env
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_USER=sirjazper
POSTGRES_PASSWORD=CHANGE_ME_use_strong_random
POSTGRES_DB=coos

# Redis (Docker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_use_strong_random

# MinIO (Docker)
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_ROOT_USER=sirjazper
MINIO_ROOT_PASSWORD=CHANGE_ME_use_strong_random
MINIO_BUCKET=sirjazper

# Server
FASTAPI_PORT=8000
FRONTEND_URL=http://localhost:3001
