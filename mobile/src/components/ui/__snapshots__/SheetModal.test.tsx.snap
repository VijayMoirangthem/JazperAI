exports[`SheetModal renders children when visible 1`] = `
<Modal
  animationType="none"
  onRequestClose={[Function]}
  presentationStyle="overFullScreen"
  transparent={true}
  visible={true}
>
  <View
    collapsable={false}
    style={
      {
        "backgroundColor": "rgba(0,0,0,0.5)",
        "flex": 1,
        "justifyContent": "flex-end",
        "opacity": 0,
      }
    }
  >
    <View
      onLayout={[Function]}
      style={
        [
          {
            "flex": 1,
            "justifyContent": "flex-end",
          },
          {
            "paddingBottom": 0,
          },
        ]
      }
    >
      <View
        collapsable={false}
        role="dialog"
        style={
          {
            "backgroundColor": "#ffffff",
            "borderTopLeftRadius": 28,
            "borderTopRightRadius": 28,
            "maxHeight": "85%",
            "overflow": "hidden",
            "transform": [
              {
                "translateY": 300,
              },
            ],
          }
        }
      >
        <View
          style={
            {
              "flex": 1,
              "padding": 16,
            }
          }
        >
          <Text
            maxFontSizeMultiplier={1.5}
            style={
              {
                "color": "#111111",
                "fontSize": 15,
              }
            }
          >
            Modal content
          </Text>
        </View>
      </View>
    </View>
  </View>
</Modal>
`;

