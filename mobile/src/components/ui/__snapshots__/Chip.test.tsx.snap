exports[`Chip applies selected styles 1`] = `
<View
  accessibilityRole="button"
  accessibilityState={
    {
      "selected": true,
    }
  }
  style={
    {
      "backgroundColor": "#2563eb",
      "borderColor": "#2563eb",
      "borderRadius": 999,
      "borderWidth": 1,
      "paddingHorizontal": 12,
      "paddingVertical": 4,
    }
  }
>
  <Text
    style={
      {
        "color": "#ffffff",
        "fontSize": 11,
        "letterSpacing": 0.5,
        "textTransform": "uppercase",
      }
    }
  >
    Selected
  </Text>
</View>
`;

