exports[`Switch respects disabled prop 1`] = `
<RCTSwitch
  accessibilityRole="switch"
  accessibilityState={
    {
      "checked": false,
      "disabled": true,
    }
  }
  disabled={true}
  onChange={[Function]}
  onResponderTerminationRequest={[Function]}
  onStartShouldSetResponder={[Function]}
  onTintColor="#2563eb"
  style={
    {
      "alignSelf": "flex-start",
    }
  }
  thumbTintColor="rgba(255,255,255,0.10)"
  tintColor="rgba(255,255,255,0.10)"
