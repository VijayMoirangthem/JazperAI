exports[`Spinner applies color prop 1`] = `
<ActivityIndicator
  accessibilityLabel="Loading"
  accessibilityRole="progressbar"
  accessibilityState={
    {
      "busy": true,
    }
  }
  color="#ff0000"
  size="large"
/>
`;

