{
  "name": "JazperAI cloud development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "forwardPorts": [
    8000,
    3001
  ],
  "postCreateCommand": "python -m pip --version && node --version && npm --version",
  "remoteUser": "vscode"
}
