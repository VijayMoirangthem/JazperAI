{
  "_doc": "Single source of truth for environment variable NAMES (never values). kind: secret = server-only credential; config = non-sensitive server setting; public = safe to ship in the browser bundle. required_in = environments (dev, staging, prod) where startup must fail closed if the variable is empty. Regenerate templates: python scripts/secrets/gen_env_examples.py",
  "environments": ["dev", "staging", "prod"],
  "services": {
    "backend": {"example": "backend/python/.env.example", "title": "FastAPI backend (backend/python)"},
    "infra": {"example": "infra/.env.example", "title": "Docker Compose data stores (infra/, backend/infra/)"},
    "frontend": {"example": "frontend/.env.example", "title": "Next.js legacy frontend (public values only)"},
    "app": {"example": "app/.env.example", "title": "Vite app (public values only)"}
  },
  "variables": [
    {"name": "ENV", "kind": "config", "services": ["backend"], "default": "development", "note": "development | staging | production"},
    {"name": "AI_BASE_URL", "kind": "config", "services": ["backend"], "default": "https://api.groq.com/openai/v1"},
    {"name": "AI_MODEL", "kind": "config", "services": ["backend"], "default": "qwen/qwen3.8-27b"},
    {"name": "LIGHT_MODEL", "kind": "config", "services": ["backend"], "default": "openai/gpt-oss-20b"},
    {"name": "AI_API_KEY", "kind": "secret", "services": ["backend"], "required_in": ["staging", "prod"], "note": "Groq or any OpenAI-compatible key"},
    {"name": "AI_API_KEY2", "kind": "secret", "services": ["backend"], "note": "optional rate-limit spread"},
    {"name": "AI_API_KEY3", "kind": "secret", "services": ["backend"], "note": "optional rate-limit spread"},
    {"name": "CLAUDE_API_KEY", "kind": "secret", "services": ["backend"]},
    {"name": "OPEN_AI_API_KEY", "kind": "secret", "services": ["backend"]},
    {"name": "OPENCODE_API_KEY", "kind": "secret", "services": ["backend"]},
    {"name": "GIT_TOKEN_JAZPER", "kind": "secret", "services": ["backend"], "note": "GitHub token for gitops features; use a fine-grained, repo-scoped token"},
    {"name": "TAVILY_API_KEY", "kind": "secret", "services": ["backend"]},
    {"name": "BRAVE_API_KEY", "kind": "secret", "services": ["backend"]},
    {"name": "EXA_AI_API_KEY", "kind": "secret", "services": ["backend"]},
    {"name": "GOOGLE_CUSTOM_SEARCH_API", "kind": "secret", "services": ["backend"]},
    {"name": "GOOGLE_CSE_ID", "kind": "config", "services": ["backend"]},
    {"name": "GOOGLE_CLIENT_ID", "kind": "config", "services": ["backend"]},
    {"name": "GOOGLE_GMAIL_CLIENT_ID", "kind": "config", "services": ["backend"]},
    {"name": "GOOGLE_CLIENT_SECRET", "kind": "secret", "services": ["backend"]},
    {"name": "GOOGLE_REDIRECT_URI", "kind": "config", "services": ["backend"], "default": "http://localhost:8000/api/google/oauth/callback"},
    {"name": "LINKEDIN_EMAIL", "kind": "secret", "services": ["backend"]},
    {"name": "LINKEDIN_PASSWORD", "kind": "secret", "services": ["backend"]},
    {"name": "LINKEDIN_CHROME_PROFILE_PATH", "kind": "config", "services": ["backend"], "note": "local path, dev machine only"},
    {"name": "RESUME_PATH", "kind": "config", "services": ["backend"], "note": "local path, dev machine only"},
    {"name": "WS_TOKEN", "kind": "secret", "services": ["backend"], "required_in": ["staging", "prod"], "note": "protects /ws/rpc"},
    {"name": "OFFICE_AUTH_REQUIRED", "kind": "config", "services": ["backend"], "default": "false"},
    {"name": "POSTGRES_HOST", "kind": "config", "services": ["backend"], "default": "127.0.0.1"},
    {"name": "POSTGRES_PORT", "kind": "config", "services": ["backend", "infra"], "default": "5433"},
    {"name": "POSTGRES_USER", "kind": "config", "services": ["backend", "infra"], "default": "sirjazper"},
    {"name": "POSTGRES_DB", "kind": "config", "services": ["backend", "infra"], "default": "coos"},
    {"name": "POSTGRES_PASSWORD", "kind": "secret", "services": ["backend", "infra"], "required_in": ["dev", "staging", "prod"]},
    {"name": "REDIS_HOST", "kind": "config", "services": ["backend"], "default": "127.0.0.1"},
    {"name": "REDIS_PORT", "kind": "config", "services": ["backend"], "default": "6379"},
    {"name": "REDIS_PASSWORD", "kind": "secret", "services": ["backend", "infra"], "required_in": ["dev", "staging", "prod"]},
    {"name": "MINIO_HOST", "kind": "config", "services": ["backend"], "default": "localhost"},
    {"name": "MINIO_PORT", "kind": "config", "services": ["backend"], "default": "9000"},
    {"name": "MINIO_BUCKET", "kind": "config", "services": ["backend"], "default": "sirjazper"},
    {"name": "MINIO_ROOT_USER", "kind": "config", "services": ["backend", "infra"], "default": "sirjazper"},
    {"name": "MINIO_ROOT_PASSWORD", "kind": "secret", "services": ["backend", "infra"], "required_in": ["staging", "prod"]},
    {"name": "FASTAPI_PORT", "kind": "config", "services": ["backend"], "default": "8000"},
    {"name": "FRONTEND_URL", "kind": "config", "services": ["backend"], "default": "http://localhost:3001"},
    {"name": "NEXT_PUBLIC_API_URL", "kind": "public", "services": ["frontend"], "default": "http://localhost:8000"},
    {"name": "NEXT_PUBLIC_WS_URL", "kind": "public", "services": ["frontend"], "default": "ws://localhost:8000"},
    {"name": "JASPER_BASE", "kind": "public", "services": ["app"], "default": "/", "note": "Vite base path"}
  ],
  "bootstrap": [
    {"name": "DOPPLER_TOKEN", "note": "scoped read-only service token for ONE project+config; the only credential each runtime holds. Provisioned by the founder in the platform's own secret store (Render/Vercel env, GitHub/Codespaces secret). Never in Git."}
  ]
}
